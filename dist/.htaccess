# ==============================================================================
# GINIBEN & PARTNERS GEOSERVICES LTD - APACHE / CPANEL HTACCESS CONFIGURATION
# Production Domain: https://ginibengeoservices.com/
# ==============================================================================

Options -Indexes
ServerSignature Off

# 1. Force HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    # Never leak referer to external image hosts (prevents ImgBB 503 hotlink rate-limiting)
    Header set Referrer-Policy "no-referrer"
</IfModule>

# 3. Protect sensitive files
<FilesMatch "(^\.env|\.sql|\.git|config\.php)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. SPA Routing vs. API Directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to existing files and directories (assets, images, api)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Explicitly route /admin to index.html for direct Admin Dashboard access
    RewriteRule ^admin/?$ index.html [L,QSA]

    # Route all other frontend navigation requests to index.html for React SPA
    RewriteRule ^ index.html [L]
</IfModule>

# 5. Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
