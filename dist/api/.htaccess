# ==============================================================================
# GiniBen & Partners GEOSERVICES LTD - API Subdirectory Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Crucial: Turn off mod_rewrite in /api/ so parent SPA rules never hijack PHP scripts
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Universal CORS Headers for all API responses
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token"
</IfModule>

# Handle preflight OPTIONS immediately
<LimitExcept GET POST PUT DELETE OPTIONS>
    Deny from all
</LimitExcept>
